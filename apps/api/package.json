{
  "name": "@broke-oclock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts tests/unit",
    "test:integration": "vitest run --config vitest.config.ts --no-file-parallelism tests/integration",
    "build": "bun build src/server.ts --target=bun --packages=external --outdir dist",
    "start": "bun dist/server.js"
  },
  "dependencies": {
    "@broke-oclock/auth": "workspace:*",
    "@broke-oclock/contracts": "workspace:*",
    "@broke-oclock/db": "workspace:*",
    "@broke-oclock/integrations": "workspace:*",
    "@broke-oclock/storage": "workspace:*",
    "@trpc/server": "11.18.0",
    "cors": "2.8.5",
    "express": "5.2.1",
    "helmet": "^8.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@trpc/client": "11.18.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "mongodb-memory-server": "11.2.0",
    "typescript": "~6.0.0",
    "vitest": "4.1.11"
  },
  "exports": {
    "./types": {
      "types": "./src/trpc/root.ts"
    }
  }
}
