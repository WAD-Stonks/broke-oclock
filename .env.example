# Broke O'Clock configuration inventory — NEVER put real credentials in this file.
# Local defaults are below. Production values live in GitHub Environment: production.
# See docs/environment-variables.md for consumers, status and secret/variable placement.
# Existing .env files are NOT overwritten by pnpm run setup; add new keys manually.

# CURRENT API + database runtime (server only)
NODE_ENV=development
PORT=3000
DATABASE_URL=mongodb://127.0.0.1:27017/broke_oclock?replicaSet=rs0&directConnection=true
# pnpm run setup generates a random local secret here; keep production's secret stable.
BETTER_AUTH_SECRET=
WEB_ORIGIN=http://localhost:5173
# Public auth origin. Production web /api proxy design uses the web HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000

# PLANNED GitHub Actions -> Vercel deployment; not consumed by the current CI.
# Deployment-only secret: never forward this token into the app runtime/browser.
VERCEL_TOKEN=UNSET
# Non-secret deployment identifiers and API origin. Both projects use the same team.
VERCEL_ORG_ID=UNCONFIGURED
VERCEL_API_PROJECT_ID=UNCONFIGURED
VERCEL_WEB_PROJECT_ID=UNCONFIGURED
API_ORIGIN=http://localhost:3000

# OneMap address search (server only; credentials are optional until lookup is enabled).
# The API uses the registered OneMap account email/password to renew an expiring token.
# Use the OneMap account password, NOT an unrelated email mailbox password.
ONEMAP_EMAIL=UNSET
ONEMAP_EMAIL_PASSWORD=UNSET
# The adapter uses the official fixed host; this legacy value is not an arbitrary URL override.
ONEMAP_BASE_URL=https://www.onemap.gov.sg

# Ingestion: leave both flags false until publisher reuse is cleared and setup is reviewed.
# MoneyDigest uses a fixed public WordPress REST endpoint; no publisher credentials needed.
INGESTION_ENABLED=false
MONEYDIGEST_REUSE_APPROVED=false
# Historical source references only; the importer does not read these or scrape Telegram.
SCOOBIFY_POSTS_URL=https://public-api.wordpress.com/wp/v2/sites/scoobifydaily.com/posts
TELEGRAM_PREVIEW_URL=https://t.me/s/thiscounted
# Reserved for a future authenticated scheduled-job endpoint; this slice uses manual admin runs.
CRON_SECRET=UNSET
# No cron schedule is provisioned by these values; scheduling remains deployment work.

# PLANNED trust/moderation configuration. Team must choose thresholds and scope first.
# Reserved names, not currently read by application code. No made-up numeric defaults.
DEAL_CONFIRM_THRESHOLD=UNCONFIGURED
DEAL_DEAD_REPORT_THRESHOLD=UNCONFIGURED
CONTENT_REPORT_THRESHOLD=UNCONFIGURED

# PHOTO STORAGE: SDK adapter/client are wired; add your real server token to enable.
# Deal-form integration and persistent photo ownership are still student-owned work.
PHOTO_STORAGE_PROVIDER=uploadthing
# Server-only SDK token from the UploadThing app dashboard; never VITE_* or public.
UPLOADTHING_TOKEN=UNSET

# WEB: no required VITE_* variables in the current same-origin auth client.
# Leaflet + public OSM tiles do not need a Google Maps API key; preserve tile attribution.
# All secrets above stay in API/deployment jobs, never in VITE_* or frontend bundles.
# RESEND EMAIL infrastructure: no automatic verification/reset emails or auth hooks enabled.
# Explicit server consumers pass these values to packages/email; missing placeholders disable sending.
RESEND_API_KEY=UNSET
# Use a sender on your verified Resend domain; never a browser VITE_* value.
EMAIL_FROM=UNCONFIGURED
