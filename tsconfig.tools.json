{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "vitest.packages.config.ts"
  ],
  "extends": "./tsconfig.json"
}
